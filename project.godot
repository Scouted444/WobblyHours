; Engine configuration file.
; Open this file with Godot 4.3 or newer (it will offer to upgrade if you use a newer version).

config_version=5

[application]

config/name="Wobbly Hours"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

InputSetup="*res://autoload/input_setup.gd"
Net="*res://autoload/net.gd"
Content="*res://autoload/content.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

3d/default_gravity=16.0
3d/solver/solver_iterations=24
common/physics_ticks_per_second=90
common/max_physics_steps_per_frame=12
